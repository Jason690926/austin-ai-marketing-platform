# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (Google AI Studio — aistudio.google.com，免費層)
# 文案生成使用 Gemini 2.5 Flash
GEMINI_API_KEY=
# 可選：覆寫文案模型，預設 gemini-2.5-flash
# GEMINI_COPY_MODEL=gemini-2.5-flash

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=ai-marketing-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sheets（Meta 廣告推送用，僅後端）
# 1) 到 Google Cloud Console 建立專案 → 啟用 Google Sheets API
# 2) 建立 Service Account → 下載 JSON 金鑰
# 3) 把整個 JSON 內容（含換行 \n 全部保留）「壓成單行」貼到下面（前後加上單引號避免被殼破壞）
# 4) 把目標 Sheet 分享給 Service Account 的 client_email（編輯者權限）
GOOGLE_SHEETS_SA_JSON=
META_AD_SHEET_ID=1ezd2-wjt8yCyPF6aQTeK5GOCPvEJgFeXfFfN5OQo0QU
# 預設用 "meta" 分頁，需改自行覆寫
# META_AD_SHEET_TAB=meta
