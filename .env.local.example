# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (Google AI Studio — aistudio.google.com)
# 文案生成使用 Gemini 3.5 Flash，產圖 Level 1 用 Nano Banana 2 (gemini-3.1-flash-image)、
# Level 2/3 燒字用途自動走 Nano Banana Pro (gemini-3-pro-image，中文字保真度最高)
# 同一把 key 共用；產圖免費層額度官方 doc 未明列，AI Studio key 實測為準
GEMINI_API_KEY=
# 可選：覆寫文案模型，預設 gemini-3.5-flash（省成本可填 gemini-3.1-flash-lite）
# GEMINI_COPY_MODEL=gemini-3.5-flash
# 可選：覆寫 Level 1 底圖模型（無燒字），預設 gemini-3.1-flash-image（省成本可降回 gemini-2.5-flash-image）
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 可選：覆寫 Level 2/3 燒字模型，預設 gemini-3-pro-image（想全程省成本可降回 gemini-3.1-flash-image）
# GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=ai-marketing-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta 自動發文（發貼文到 Facebook Page，僅後端）
# 1) 到 developers.facebook.com 建立 App
# 2) 取得目標 Page 的「長期 Page Access Token」（約 60 天，避免短期 1 小時失效）
# 3) META_PAGE_ID 是粉專的數字 ID；META_PAGE_NAME 僅作 UI 顯示用
META_PAGE_ID=
META_PAGE_NAME=總公司粉專
META_PAGE_ACCESS_TOKEN=

# Google Sheets（Meta 廣告推送用，僅後端）
# 1) 到 Google Cloud Console 建立專案 → 啟用 Google Sheets API
# 2) 建立 Service Account → 下載 JSON 金鑰
# 3) 把整個 JSON 內容（含換行 \n 全部保留）「壓成單行」貼到下面（前後加上單引號避免被殼破壞）
# 4) 把目標 Sheet 分享給 Service Account 的 client_email（編輯者權限）
GOOGLE_SHEETS_SA_JSON=
META_AD_SHEET_ID=1ezd2-wjt8yCyPF6aQTeK5GOCPvEJgFeXfFfN5OQo0QU
# 預設用 "meta" 分頁，需改自行覆寫
# META_AD_SHEET_TAB=meta
